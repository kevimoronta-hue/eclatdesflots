# L'Éclat des Flots — environment variables
# Copy to `.env.local` for local dev, and set these in the Vercel project settings
# for production. NEVER put real secret values in this file — names only.

# ── Session signing (REQUIRED in production) ─────────────────────────────────
# Long random string used to sign the admin session cookie (HMAC).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# ── Admin account recovery (REQUIRED for the unlock flow) ───────────────────
# Recovery key you keep private. Used to unlock the admin account after 5 failed
# logins. Provide EITHER a plain key OR (preferred) a bcrypt hash of it.
# The key must never be committed or returned by any API.
ADMIN_UNLOCK_KEY=
# Optional, preferred: bcrypt hash of the unlock key (leave ADMIN_UNLOCK_KEY empty).
ADMIN_UNLOCK_KEY_HASH=

# ── Database: Vercel KV / Upstash Redis (REQUIRED in production) ─────────────
# Persists the admin user (hashed password), lockout counter, CMS content and
# history. Added automatically by the Vercel KV / Upstash integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Upstash direct integrations may instead expose these — either pair works.)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Reserved: only needed if you swap the KV adapter for a Postgres-based store.
# The default adapter uses the KV_REST_API_* pair above, not DATABASE_URL.
DATABASE_URL=

# ── Image storage: Vercel Blob ─────────────────────────────────────────────
# Used for admin content images AND the quote-form photos (uploaded directly
# from the browser to Blob, then emailed as links). Added automatically when
# you create a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# ── Quote form email (Resend) ───────────────────────────────────────────────
# API key from resend.com — server-side only, never exposed to the client.
RESEND_API_KEY=
# Recipient of quote requests. Fixed server-side (the visitor never chooses it).
CONTACT_EMAIL=contact@eclatdesflots.fr
# Verified Resend sender on your domain (once eclatdesflots.fr is verified in Resend).
QUOTE_FROM_EMAIL=devis@eclatdesflots.fr
# Dev-only test aid: set to "true" (locally) to write emails to .data/outbox
# instead of sending. Ignored in production. Leave empty otherwise.
QUOTE_DEV_OUTBOX=

# ── Dev-only preview (NEVER set in production) ──────────────────────────────
# When "true" AND not in production, /admin runs in a zero-persistence preview
# mode: the full UI is testable but nothing is ever written (no DB, no uploads,
# no password change, no lockout). Forced OFF automatically on Vercel production.
ADMIN_PREVIEW_MODE=false

# ── Pre-existing (public, not secrets) ──────────────────────────────────────
# Contact phone / email / LinkedIn are now managed from /admin (the CMS), not env.
WISTIA_MEDIA_ID=o968et3qik
BOOKING_EMBED_URL=
