{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,
  "redirects": [
    { "source": "/Accueil.dc.html", "destination": "/", "permanent": true },
    { "source": "/en/", "destination": "/en", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales.html" },
    { "source": "/politique-de-confidentialite", "destination": "/politique-de-confidentialite.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/legal-notice", "destination": "/en/legal-notice.html" },
    { "source": "/en/privacy-policy", "destination": "/en/privacy-policy.html" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
